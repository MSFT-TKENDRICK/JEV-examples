{
  "name": "jev-examples",
  "version": "1.0.0",
  "private": true,
  "description": "Runnable examples showing how to use TypeSafe AI's Jev decision model with @typesafe-ai/sdk and the Vercel AI SDK.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "quickstart": "node --env-file-if-exists=.env scripts/run-example.ts examples/01-quickstart.ts",
    "judge": "node --env-file-if-exists=.env scripts/run-example.ts examples/02-judge-rubrics.ts",
    "harness": "node --env-file-if-exists=.env scripts/run-example.ts examples/03-agent-harness.ts",
    "browser": "node --env-file-if-exists=.env scripts/run-example.ts examples/04-browser-use.ts",
    "record": "node --env-file-if-exists=.env scripts/run-example.ts examples/05-browser-live.ts",
    "compare": "node --env-file-if-exists=.env scripts/run-example.ts examples/06-jev-vs-control.ts",
    "fsi:card-servicing": "node --env-file-if-exists=.env scripts/run-example.ts examples/fsi/07-card-servicing/index.ts",
    "fsi:runbook-routing": "node --env-file-if-exists=.env scripts/run-example.ts examples/fsi/08-runbook-routing/index.ts",
    "fsi:fraud-alerts": "node --env-file-if-exists=.env scripts/run-example.ts examples/fsi/09-fraud-alerts/index.ts",
    "fsi:insurance-claims": "node --env-file-if-exists=.env scripts/run-example.ts examples/fsi/10-insurance-claims/index.ts",
    "fsi:content-safety": "node --env-file-if-exists=.env scripts/run-example.ts examples/fsi/11-content-safety/index.ts",
    "fsi:compliance-audit": "node --env-file-if-exists=.env scripts/run-example.ts examples/fsi/12-compliance-audit/index.ts",
    "fsi:semantic-signals": "node --env-file-if-exists=.env scripts/run-example.ts examples/fsi/13-semantic-signals/index.ts",
    "fsi:search-rerank": "node --env-file-if-exists=.env scripts/run-example.ts examples/fsi/14-search-rerank/index.ts",
    "fsi:eval": "node --env-file-if-exists=.env examples/fsi/eval/index.ts",
    "all": "node --env-file-if-exists=.env scripts/run-examples.ts",
    "all:mock": "node --env-file-if-exists=.env scripts/run-examples.ts --mock",
    "example": "node --env-file-if-exists=.env scripts/run-example.ts",
    "python:install": "python -m pip install -r examples/python/requirements.txt",
    "typecheck": "tsc -p tsconfig.json",
    "check:client": "node src/client.check.ts && node scripts/backend.check.ts",
    "check:local-jev": "node local-jev/app.check.ts",
    "check:foundation": "node src/ledger.check.ts && node src/information-gain.check.ts && node src/mock-fetch.check.ts && node src/compensate.check.ts && node src/frontier.check.ts",
    "check:eval": "node examples/fsi/eval/sweep.check.ts",
    "check:decision-loop": "node src/decision-loop.check.ts",
    "check:fsi-examples": "node examples/fsi/scenarios.check.ts",
    "check": "npm run typecheck && npm run check:client && npm run check:local-jev && npm run check:foundation && npm run check:decision-loop && npm run check:eval && npm run check:fsi-examples && npm run check:media && npm run check:docs",
    "check:media": "node scripts/media-check.ts",
    "check:docs": "node scripts/check-docs.ts",
    "local-jev:install": "npm install --prefix local-jev --no-package-lock --no-audit --no-fund",
    "local-jev": "node --env-file-if-exists=.env local-jev/main.ts",
    "local-jev:parity": "node --env-file-if-exists=.env local-jev/parity.ts",
    "local-jev:typecheck": "tsc -p local-jev/tsconfig.json"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.14",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "webreel": "^0.1.4"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.81",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.101",
    "zod": "^4.6.5"
  }
}
