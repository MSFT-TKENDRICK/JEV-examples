# Vercel AI Gateway — routes to Jev as `typesafe-ai/jev`.
# Get a key at https://vercel.com/ai-gateway. Jev is the cheapest model on the
# Gateway ($0.042 / 1M input tokens) and has had promotional free windows.
AI_GATEWAY_API_KEY=

# Optional: talk to TypeSafe directly instead of through the Gateway.
# Used only by the Python examples in examples/python/.
TYPESAFE_API_KEY=

# Optional overrides.
# JEV_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
# JEV_MODEL=typesafe-ai/jev

# Force the offline mock transport even when a key is present.
# JEV_MOCK=1
