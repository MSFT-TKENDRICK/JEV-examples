# Jev — the official TypeSafe SDK reads TYPESAFE_API_KEY.
# Get one at https://typesafe.ai. Without it, the examples run on an offline mock.
TYPESAFE_API_KEY=

# Optional: override the model (default `jev-latest`) or the API root.
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional: `debug` logs request headers and bodies. Default `warn`.
TYPESAFE_LOG_LEVEL=warn

# The Vercel AI Gateway key, used by example 03 for the *generative* half of
# the agent (proposing commands). One key covers every provider.
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Force the offline mocks even when the keys above are set.
JEV_MOCK=
