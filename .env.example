# Jev through Vercel AI Gateway (free input/output in the catalog on 2026-09-22).
# https://vercel.com/ai-gateway/models/providers/typesafe-ai
# Get a Gateway key: https://vercel.com/ai-gateway
# No direct TypeSafe account or TYPESAFE_API_KEY is required.
# npm example commands load .env; direct node commands need exported variables.
AI_GATEWAY_API_KEY=

# Alternative Gateway authentication for Vercel environments.
VERCEL_OIDC_TOKEN=

# TypeSafe-compatible Gateway API; not the direct TypeSafe service.
AI_GATEWAY_TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
TYPESAFE_DEFAULT_MODEL=typesafe-ai/jev
TYPESAFE_LOG_LEVEL=warn

# Optional PAID generative triage/control/proposer calls through Gateway.
# Leave 0 for live Jev + labelled generative replays; set 1 to opt into charges.
AI_GATEWAY_GENERATIVE=0

# Explicit test-only mode: 1 scripts Jev answers instead of performing inference.
# Leave empty (or 0) for real Jev. npm run all:mock sets this for child runs.
JEV_MOCK=

# Opt-in local backend, not Jev: JEV_BACKEND=local sends the same TypeSafe
# requests to the Laya proxy in local-jev/ (npm run local-jev). Every banner,
# ledger and response names Laya. Leave empty for Jev through Gateway.
JEV_BACKEND=
LOCAL_JEV_URL=http://127.0.0.1:8765
# SDK timeout for local CPU inference (ms).
LOCAL_JEV_TIMEOUT_MS=120000
# Proxy settings (read by npm run local-jev):
# extend (default) | reject | truncate — input beyond Laya's trained 512/192 tokens.
LOCAL_JEV_OVERFLOW=extend
LOCAL_JEV_PORT=8765
# LOCAL_JEV_MODEL_DIR=   exported Laya ONNX bundle; default downloads the pinned one
# LOCAL_JEV_THREADS=     ONNX Runtime intra-op threads; default is fastest measured here
